@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="dc-page dc-auth">
    <h1 class="dc-title">¿Olvidaste tu contraseña?</h1>
    <p class="dc-lead mb-4">Ingresá tu email y te mandamos un enlace para crear una nueva.</p>

    <div class="dc-card">
        <form method="post">
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <button type="submit" class="btn btn-dark btn-lg w-100">Enviar enlace</button>
        </form>
    </div>

    <p class="text-center small text-secondary mt-4">
        <a asp-page="./Login">Volver a iniciar sesión</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
