@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar cuenta";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="dc-card dc-danger-zone">
    <h2 class="dc-card-title">Eliminar cuenta</h2>

    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>
            <strong>Esta acción no se puede deshacer.</strong>
            @if (Model.CantidadDocumentos == 1)
            {
                <text>Se va a borrar también el documento de tu panel.</text>
            }
            else if (Model.CantidadDocumentos > 1)
            {
                <text>Se van a borrar también los @Model.CantidadDocumentos documentos de tu panel.</text>
            }
            Las huellas ya registradas en la blockchain no se borran.
        </div>
    </div>

    <form id="delete-user" method="post" style="max-width: 420px;">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="mb-4">
            <label asp-for="Input.Password" class="form-label">Confirmá con tu contraseña</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-danger" type="submit">Eliminar mi cuenta definitivamente</button>
            <a asp-page="./PersonalData" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
