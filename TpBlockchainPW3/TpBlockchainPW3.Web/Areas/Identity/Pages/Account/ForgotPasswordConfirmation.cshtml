@page
@{
    ViewData["Title"] = "Revisá tu email";
    // Solo existe en desarrollo, cuando no hay un servicio de email real (ver ForgotPasswordModel)
    var enlace = TempData["EnlaceRestablecer"] as string;
}

<div class="dc-page dc-auth text-center">
    <h1 class="dc-title">Revisá tu email</h1>
    <p class="dc-lead mx-auto mb-4">Si el email corresponde a una cuenta, te enviamos un enlace para elegir una contraseña nueva.</p>

    @if (enlace != null)
    {
        <div class="alert alert-warning text-start mb-4" role="status">
            <i class="bi bi-tools"></i>
            <div>
                <strong>Modo desarrollo:</strong> como no hay un servicio de email configurado, podés seguir desde acá.
                <div class="mt-2"><a class="btn btn-sm btn-dark" href="@enlace">Elegir contraseña nueva</a></div>
            </div>
        </div>
    }

    <a class="btn btn-outline-secondary" asp-page="./Login">Volver a iniciar sesión</a>
</div>
