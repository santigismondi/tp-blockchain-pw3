@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="dc-page dc-auth">
    <h1 class="dc-title">Iniciá sesión</h1>
    <p class="dc-lead mb-4">Entrá a tu panel para registrar documentos y emitir certificados.</p>

    <div class="dc-card">
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <a class="small" asp-page="./ForgotPassword">¿La olvidaste?</a>
                </div>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label small" asp-for="Input.RememberMe">Recordarme en este equipo</label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-dark btn-lg w-100">Iniciar sesión</button>
        </form>
    </div>

    <div class="text-center small text-secondary mt-4 d-flex flex-column gap-1">
        <span>¿No tenés cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Creá una</a></span>
        <a asp-page="./ResendEmailConfirmation">Reenviar el email de confirmación</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
