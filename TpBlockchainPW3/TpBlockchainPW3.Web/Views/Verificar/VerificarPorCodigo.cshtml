@model TpBlockchainPW3.Web.Models.VerificarPorCodigoModel
@{
    ViewData["Title"] = "Verificar por Código";
}

<div class="container my-4" style="max-width: 600px;">
    <h2 class="mb-3">Verificar documento por código</h2>
    <p class="text-muted">
        Ingresá el código único impreso en el certificado para consultar su estado en la blockchain de forma rápida.
    </p>

    <form asp-action="PorCodigo" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Codigo" class="form-label"></label>
            <input asp-for="Codigo" class="form-control" placeholder="Ej: DOC-2026-0001" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Verificar Código</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">O verificar subiendo archivo</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}