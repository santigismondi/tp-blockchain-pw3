@model TpBlockchainPW3.Web.Models.ResultadoVerificacion

@{
// 1. Auténtico: la blockchain confirmó que existe.
// 2. No registrado: la blockchain dijo que no existe (enCadena = false sin excepciones).
// 3. No se pudo verificar: se maneja si el controlador capturó un error o si modelo es nulo.
}

<div class="dc-card dc-result @(Model.Autentico ? "is-ok" : "is-fail")">
    <div class="dc-result-head">
        <span class="dc-result-icon">
            <i class="bi @(Model.Autentico ? "bi-check-lg" : "bi-x-lg")"></i>
        </span>
        <div>
            @if (Model.Autentico)
            {
                <h2 class="dc-result-title">Documento auténtico</h2>
                <p class="mb-0 text-secondary">
                    El archivo es idéntico al registrado en la blockchain
                    @if (Model.FechaBlockchain is not null)
                    {
                        <text>el <strong class="text-body">@Model.FechaBlockchain.Value.ToLocalTime().ToString("dd/MM/yyyy 'a las' HH:mm")</strong></text>
                    }.
                </p>
            }
            else
            {
                <h2 class="dc-result-title">No registrado</h2>
                <p class="mb-0 text-secondary">
                    Este archivo no coincide con ningún documento registrado: o nunca se registró, o fue modificado.
                </p>
            }
        </div>
    </div>

    <div class="dc-result-body">
        <dl class="dc-dl">
            @if (Model.Autentico && Model.Documento is not null)
            {
                <div>
                    <dt>Título</dt>
                    <dd>@Model.Documento.Titulo</dd>
                </div>
                <div>
                    <dt>Código</dt>
                    <dd><span class="dc-mono">@Model.Documento.Codigo</span></dd>
                </div>
            }
            @if (Model.Autentico && !string.IsNullOrEmpty(Model.EmisorBlockchain))
            {
                <div>
                    <dt>Registrado por</dt>
                    <dd><span class="dc-mono">@Model.EmisorBlockchain</span></dd>
                </div>
            }
            @if (!Model.Autentico)
            {
                <div>
                    <dt>Huella del archivo</dt>
                    <dd>
                        <div class="dc-hash">
                            <span class="dc-mono">@Model.HashSha256</span>
                            <button type="button" class="dc-copy" data-copiar="@Model.HashSha256" title="Copiar huella" aria-label="Copiar huella">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                        <div class="dc-hint mt-2">Ninguna huella registrada en la blockchain coincide con esta.</div>
                    </dd>
                </div>
            }
        </dl>

        @if (Model.Autentico)
        {
            @* Si es auténtico, la huella del archivo es la misma que encontramos en la cadena *@
            <div class="dc-compare mt-4">
                <div class="dc-compare-row">
                    <div class="dc-compare-label"><i class="bi bi-file-earmark"></i> Huella del archivo que subiste</div>
                    <span class="dc-mono">@Model.HashSha256</span>
                </div>
                <div class="dc-compare-match">
                    <i class="bi bi-check-circle-fill"></i> Coinciden los 64 caracteres
                </div>
                <div class="dc-compare-row">
                    <div class="dc-compare-label"><i class="bi bi-boxes"></i> Huella registrada en la blockchain</div>
                    <span class="dc-mono">@Model.HashSha256</span>
                </div>
            </div>
        }
    </div>
</div>

<p class="dc-hint d-flex gap-2 mt-3 mb-0">
    <i class="bi bi-info-circle"></i>
    <span>Auténtico significa que el archivo no fue modificado; no garantiza que su contenido sea verdadero.</span>
</p>
