@model TpBlockchainPW3.Web.Models.ResultadoVerificacion
@{
    ViewData["Title"] = "Resultado de la verificación";
}

<div class="dc-page dc-narrow">
    <h1 class="visually-hidden">Resultado de la verificación</h1>

    <partial name="_ResultadoVerificacion" model="Model" />

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-action="Index" class="btn btn-dark">
            <i class="bi bi-arrow-counterclockwise"></i> Verificar otro archivo
        </a>
        <a asp-action="PorCodigo" class="btn btn-outline-secondary">Verificar por código</a>
    </div>
</div>
