@model TpBlockchainPW3.Web.Models.SubirDocumentoModel

@{
    ViewData["Title"] = "Subir documento";
}

<div class="dc-page dc-narrow">
    <a asp-action="Index" class="small text-secondary text-decoration-none d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Mis documentos
    </a>
    <h1 class="dc-title">Registrar un documento</h1>
    <p class="dc-lead mb-4">Calculamos la huella del archivo y la guardamos en la blockchain como prueba de su existencia.</p>

    <div class="dc-card">
        <form asp-action="Subir" method="post" enctype="multipart/form-data" id="formSubirDoc">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="mb-4">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej.: Título secundario" />
                <span asp-validation-for="Titulo"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" class="form-select" asp-items="Html.GetEnumSelectList<TpBlockchainPW3.Web.Models.TipoDocumento>()"></select>
                <span asp-validation-for="Tipo"></span>
            </div>

            <div>
                <label asp-for="Archivo" class="form-label"></label>
                <div class="dc-drop">
                    <input asp-for="Archivo" type="file" />
                    <div class="dc-drop-empty">
                        <i class="bi bi-cloud-arrow-up dc-drop-icon"></i>
                        <span class="dc-drop-title">Arrastrá el archivo o <u>elegilo desde tu equipo</u></span>
                        <span class="dc-hint">Tamaño máximo permitido: 10 MB</span>
                    </div>
                    <div class="dc-drop-pill">
                        <i class="bi bi-file-earmark-check"></i>
                        <div class="flex-grow-1 overflow-hidden">
                            <span class="dc-drop-name"></span>
                            <span class="dc-drop-size"></span>
                        </div>
                        <button type="button" class="dc-drop-clear" aria-label="Quitar archivo" title="Quitar archivo"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
                <span asp-validation-for="Archivo" class="d-block mt-2"></span>
            </div>

            <div id="alertaProcesando" class="alert alert-warning d-none mt-4 mb-0" role="status">
                <div class="spinner-border spinner-border-sm mt-1 flex-shrink-0" aria-hidden="true"></div>
                <div>
                    <strong>Registrando en la blockchain…</strong> Esto puede tardar unos segundos. No cierres ni recargues la página.
                </div>
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mt-4 pt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" id="btnSubmit" class="btn btn-primary">
                    Registrar en la blockchain <i class="bi bi-arrow-right dc-arrow"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('formSubirDoc').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                document.getElementById('btnSubmit').disabled = true;
                document.getElementById('alertaProcesando').classList.remove('d-none');
            }
        });
    </script>
}
