@model IEnumerable<TpBlockchainPW3.Web.Models.Documento>

@{
    ViewData["Title"] = "Mis documentos";
}

<div class="dc-page">
    <div class="dc-page-header">
        <div>
            <h1 class="dc-title">Mis documentos</h1>
            <p class="dc-lead">Todo lo que registraste en la blockchain, con su estado y su certificado.</p>
        </div>
        <a asp-action="Subir" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Subir documento
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="dc-card dc-empty">
            <i class="bi bi-folder2-open"></i>
            <h2 class="h5 mt-3 mb-1">Todavía no registraste documentos</h2>
            <p class="text-secondary mb-4">Subí el primero y vas a obtener su huella y su comprobante en la blockchain.</p>
            <a asp-action="Subir" class="btn btn-primary">Subir mi primer documento</a>
        </div>
    }
    else
    {
        <div class="dc-card dc-table-wrap">
            <div class="table-responsive">
                <table class="table table-hover dc-table">
                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th>Código</th>
                            <th>Creado</th>
                            <th>Estado</th>
                            <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="fw-medium text-body text-decoration-none">@item.Titulo</a>
                                    <div class="small text-secondary">@item.Tipo</div>
                                </td>
                                <td><span class="dc-mono text-nowrap">@item.Codigo</span></td>
                                <td class="text-secondary text-nowrap">@item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><partial name="_EstadoBadge" model="item.Estado" /></td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Ver detalle</a>
                                    <a asp-action="GenerarCertificado" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Descargar certificado en PDF">
                                        <i class="bi bi-file-earmark-pdf"></i> Certificado
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
