@model TpBlockchainPW3.Web.Models.Documento

@{
    ViewData["Title"] = "Detalle del documento";
}

<div class="dc-page">
    <a asp-action="Index" class="small text-secondary text-decoration-none d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Mis documentos
    </a>

    <div class="dc-page-header">
        <div>
            <h1 class="dc-title">@Model.Titulo</h1>
            <div class="dc-meta">
                <partial name="_EstadoBadge" model="Model.Estado" />
                <span>@Model.Tipo</span>
                <span class="dc-mono">@Model.Codigo</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @* El archivo descargado es exactamente el registrado: su huella coincide con la de la blockchain *@
            <a asp-action="Descargar" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-download"></i> @(Model.Tipo == TpBlockchainPW3.Web.Models.TipoDocumento.Certificado ? "Descargar certificado" : "Descargar archivo")
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="dc-card h-100">
                <h2 class="dc-card-title">Datos del documento</h2>
                <dl class="dc-dl">
                    <div>
                        <dt>Código</dt>
                        <dd>
                            <span class="dc-mono">@Model.Codigo</span>
                            <button type="button" class="dc-copy ms-1" data-copiar="@Model.Codigo" title="Copiar código" aria-label="Copiar código">
                                <i class="bi bi-copy"></i>
                            </button>
                        </dd>
                    </div>
                    <div>
                        <dt>Tipo</dt>
                        <dd>@Model.Tipo</dd>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.NombreDestinatario))
                    {
                        <div>
                            <dt>Destinatario</dt>
                            <dd>
                                @Model.NombreDestinatario
                                @if (!string.IsNullOrEmpty(Model.DniDestinatario))
                                {
                                    <span class="text-secondary">· DNI @Model.DniDestinatario</span>
                                }
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Materia))
                    {
                        <div>
                            <dt>Materia</dt>
                            <dd>
                                @Model.Materia
                                @if (Model.Nota != null)
                                {
                                    <span class="text-secondary">· Nota @Model.Nota.Value.ToString("0.##")</span>
                                }
                            </dd>
                        </div>
                    }
                    <div>
                        <dt>Archivo</dt>
                        <dd class="text-break">@Model.NombreArchivo</dd>
                    </div>
                    <div>
                        <dt>Creado</dt>
                        <dd>@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div>
                        <dt>Registrado</dt>
                        <dd>@(Model.FechaRegistro?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="dc-card h-100">
                <h2 class="dc-card-title">Prueba en la blockchain</h2>

                <div class="mb-4">
                    <div class="small text-secondary mb-2">Huella del archivo (SHA-256)</div>
                    <div class="dc-hash">
                        <span class="dc-mono">@Model.HashSha256</span>
                        <button type="button" class="dc-copy" data-copiar="@Model.HashSha256" title="Copiar huella" aria-label="Copiar huella">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <div class="small text-secondary mb-2">Transacción (TxHash)</div>
                    @if (!string.IsNullOrEmpty(Model.TxHash))
                    {
                        <div class="dc-hash">
                            <span class="dc-mono">@Model.TxHash</span>
                            <button type="button" class="dc-copy" data-copiar="@Model.TxHash" title="Copiar transacción" aria-label="Copiar transacción">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="dc-hash text-secondary">No disponible o pendiente de registro.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
