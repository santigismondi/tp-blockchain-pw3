@model TpBlockchainPW3.Web.Models.Documento

@{
    ViewData["Title"] = "Detalle del Documento";
}

<div class="container mt-4">
    <h2>Detalle del Documento</h2>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title text-primary">@Model.Titulo</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">Código:</dt>
                <dd class="col-sm-9"><code>@Model.Codigo</code></dd>

                <dt class="col-sm-3">Tipo:</dt>
                <dd class="col-sm-9">@Model.Tipo</dd>
                @if (!string.IsNullOrEmpty(Model.NombreDestinatario))
                {
                    <dt class="col-sm-3">Destinatario:</dt>
                    <dd class="col-sm-9">@Model.NombreDestinatario (DNI @Model.DniDestinatario)</dd>
                }

                @if (!string.IsNullOrEmpty(Model.Materia))
                {
                    <dt class="col-sm-3">Materia:</dt>
                    <dd class="col-sm-9">@Model.Materia @(Model.Nota != null ? $"- Nota {Model.Nota}" : "")</dd>
                }

                <dt class="col-sm-3">Estado:</dt>
                <dd class="col-sm-9">
                    <partial name="_EstadoBadge" model="Model.Estado" />
                </dd>

                <dt class="col-sm-3">Huella (SHA-256):</dt>
                <dd class="col-sm-9"><small class="text-break">@Model.HashSha256</small></dd>

                <dt class="col-sm-3">TxHash (Blockchain):</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.TxHash))
                    {
                        <code class="text-break">@Model.TxHash</code>
                    }
                    else
                    {
                        <span class="text-muted">No disponible o pendiente de registro</span>
                    }
                </dd>

                <dt class="col-sm-3">Fecha de Registro:</dt>
                <dd class="col-sm-9">@(Model.FechaRegistro?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</dd>

                <dt class="col-sm-3">Fecha de Creación:</dt>
                <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Descargar" asp-route-id="@Model.Id" class="btn btn-primary">Descargar archivo</a>
                <a asp-action="Index" class="btn btn-secondary">Volver al Panel</a>
            </div>
        </div>
    </div>
</div>