@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">DocChain</h1>
    <p class="lead mb-1">Registrá tus documentos en la blockchain y obtené una prueba de que existen y no fueron modificados.</p>
    <p class="lead">Cualquier persona puede verificar su autenticidad subiendo el archivo.</p>

    <div class="mt-4 d-flex justify-content-center gap-2">
        <a class="btn btn-primary btn-lg" asp-controller="Verificar" asp-action="Index">Verificar un documento</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
        }
    </div>
</div>