@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="dc-page dc-narrow text-center">
    <h1 class="dc-title">Algo salió mal.</h1>
    <p class="dc-lead mx-auto mb-4">Ocurrió un error al procesar tu solicitud. Probá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="dc-hint">
            Código de la solicitud: <span class="dc-mono">@Model.RequestId</span>
        </p>
    }

    <a class="btn btn-dark mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
